// This is your Prisma schema file for TEKMS Listing Manager
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?   // For credential login (hashed with bcrypt)
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  
  // Legacy feature permissions (admin can grant)
  allowLegacyEtsyImport   Boolean @default(false)
  allowLegacyTikTokExport Boolean @default(false)
  
  // Relations
  accounts         Account[]
  sessions         Session[]
  subscription     Subscription?
  credentials      UserCredential[]
  storeConnections StoreConnection[]
  usageRecords     UsageRecord[]
  products         Product[]
  syncJobs         SyncJob[]
  bulkOperations   BulkOperation[]
  savedFilters     SavedFilter[]
  aiOperations     AIOperation[]
  
  // POD Platform Relations
  masterProducts   MasterProduct[]
  channelListings  ChannelListing[]
  categoryMappings CategoryMapping[]
  pricingRules     PricingRule[]
  productTemplates ProductTemplate[]
  designLibrary    DesignLibrary[]
  inventoryLevels  InventoryLevel[]
  changeLogs       ChangeLog[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([email])
}

enum UserRole {
  USER
  ADMIN
}

// OAuth Accounts (Google, etc.)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Sessions for NextAuth
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// Email verification tokens
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  
  @@unique([identifier, token])
}

// ============================================
// SUBSCRIPTIONS & BILLING
// ============================================

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  stripeCustomerId       String?            @unique
  stripeSubscriptionId   String?            @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  tier                   SubscriptionTier   @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  cancelAtPeriodEnd      Boolean            @default(false)
  
  // Admin gifted subscription tracking
  isGifted               Boolean  @default(false)
  giftedBy               String?  // Admin user ID who gifted
  giftDuration           Int?     // Duration in months (1, 3, 12)
  giftStartedAt          DateTime?
  giftExpiresAt          DateTime?
  giftNote               String?  // Optional note from admin
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([isGifted, giftExpiresAt])
}

enum SubscriptionTier {
  FREE        // 1 store, 10 products total
  PAID        // Unlimited stores, per-store billing
  ENTERPRISE  // Custom pricing
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

// Dynamic Pricing Plans (Admin Manageable)
model PricingPlan {
  id              String   @id @default(cuid())
  tier            SubscriptionTier @unique
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  yearlyPrice     Decimal? @db.Decimal(10, 2)
  stripePriceId   String?
  stripeYearlyPriceId String?
  
  // Limits
  productLimit    Int      // -1 for unlimited
  apiCallLimit    Int?
  storageLimit    Int?
  
  // Features (stored as JSON array)
  features        Json
  
  // Platform Access
  allowBigCommerce Boolean @default(true)
  allowShopify     Boolean @default(true)
  allowEtsy        Boolean @default(false)
  allowTikTok      Boolean @default(false)
  
  // Special Features
  allowBulkOps     Boolean @default(false)
  allowScheduledSync Boolean @default(false)
  allowAdvancedAnalytics Boolean @default(false)
  allowPrioritySupport Boolean @default(false)
  allowAPIAccess   Boolean @default(false)
  
  // Display
  isActive        Boolean @default(true)
  displayOrder    Int     @default(0)
  isPopular       Boolean @default(false)
  badgeText       String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([tier])
  @@index([isActive, displayOrder])
}

// ============================================
// PLATFORM CREDENTIALS
// ============================================

model UserCredential {
  id           String   @id @default(cuid())
  userId       String
  platform     Platform
  encryptedKey String   @db.Text // AES-256-GCM encrypted
  label        String?
  isActive     Boolean  @default(true)
  isLegacy     Boolean  @default(true) // Mark as legacy credential
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, platform, label])
  @@index([userId, platform])
}

enum Platform {
  BIGCOMMERCE
  SHOPIFY
  TIKTOK
  ETSY
}

// ============================================
// STORE CONNECTIONS (OAuth)
// ============================================

model StoreConnection {
  id                String   @id @default(cuid())
  userId            String
  platform          Platform
  
  // Store Info
  storeName         String
  storeUrl          String?
  externalStoreId   String   // Platform's unique store ID
  
  // OAuth Tokens (encrypted with AES-256-GCM)
  accessToken       String   @db.Text
  refreshToken      String?  @db.Text
  tokenExpiresAt    DateTime?
  
  // Scopes granted
  scopes            String[]
  
  // Status
  isActive          Boolean  @default(true)
  lastSyncedAt      DateTime?
  syncStatus        String?  // "connected", "error", "needs_reauth"
  syncError         String?
  
  // Product tracking
  productCount      Int      @default(0) // Cached count for billing
  
  // Platform-specific metadata
  metadata          Json?
  
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  products           Product[]
  channelListings    ChannelListing[]
  webhookEvents      WebhookEvent[]
  storeSubscription  StoreSubscription?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, platform, externalStoreId])
  @@index([userId, platform])
  @@index([userId, isActive])
}

// ============================================
// PER-STORE SUBSCRIPTION & BILLING
// ============================================

model StoreSubscription {
  id                     String   @id @default(cuid())
  storeConnectionId      String   @unique
  userId                 String   // Denormalized for easy queries
  
  // Stripe details
  stripeSubscriptionId   String?  @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  
  // Current pricing tier for this store
  pricingTierId          String
  productCount           Int      @default(0)
  
  // Status
  status                 SubscriptionStatus @default(ACTIVE)
  cancelAtPeriodEnd      Boolean  @default(false)
  
  // Relations
  storeConnection StoreConnection  @relation(fields: [storeConnectionId], references: [id], onDelete: Cascade)
  pricingTier     StorePricingTier @relation(fields: [pricingTierId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([storeConnectionId])
  @@index([stripeSubscriptionId])
}

// Admin-Manageable Store Pricing Tiers
model StorePricingTier {
  id              String   @id @default(cuid())
  name            String   // "Starter", "Growth", "Pro", etc.
  
  // Product range
  minProducts     Int      // e.g., 10
  maxProducts     Int      // e.g., 100 (-1 for unlimited)
  
  // Pricing
  monthlyPrice    Decimal  @db.Decimal(10, 2)
  yearlyPrice     Decimal? @db.Decimal(10, 2)
  stripePriceId   String?  // Stripe monthly price ID
  stripeYearlyPriceId String?
  
  // Features
  features        Json     // Array of feature strings
  
  // Display
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  description     String?
  
  // Relations
  storeSubscriptions StoreSubscription[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([isActive, displayOrder])
  @@index([minProducts, maxProducts])
}

// ============================================
// PRODUCTS & SYNC
// ============================================

model Product {
  id               String   @id @default(cuid())
  userId           String
  platform         Platform
  externalId       String
  
  // Connection source (nullable for legacy imports)
  storeConnectionId String?
  importMethod      String   @default("oauth") // "oauth" or "legacy"
  
  // Core fields
  name             String
  description      String?  @db.Text
  sku              String?
  price            Decimal  @db.Decimal(10, 2)
  compareAtPrice   Decimal? @db.Decimal(10, 2)
  
  // Search optimization
  searchVector     String?
  categories       String[]
  tags             String[]
  
  // Metadata
  images           Json?
  variants         Json?
  customFields     Json?
  platformData     Json?    // Store original platform data
  
  // Sync status
  lastSyncedAt     DateTime?
  syncStatus       String?
  syncError        String?
  
  // Reference to master product (if this is a synced product)
  masterProductId  String?
  channelListingId String?
  
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeConnection StoreConnection? @relation(fields: [storeConnectionId], references: [id])
  masterProduct   MasterProduct?   @relation(fields: [masterProductId], references: [id], onDelete: SetNull)
  channelListing  ChannelListing?  @relation(fields: [channelListingId], references: [id], onDelete: SetNull)
  
  // Full sync relations
  productVariants      ProductVariant[]
  productModifiers     ProductModifier[]
  productOptions       ProductOption[]
  productCustomFields  ProductCustomField[]
  productSEO           ProductSEO?
  productShipping      ProductShipping?
  productInventory     ProductInventory[]
  productBulkPricing   ProductBulkPricing[]
  productReviews       ProductReview[]
  crossListings        CrossListing[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, platform, externalId, importMethod])
  @@index([userId, platform])
  @@index([userId, createdAt])
  @@index([storeConnectionId])
  @@index([importMethod])
}

model SyncJob {
  id          String   @id @default(cuid())
  userId      String
  platform    Platform
  action      String
  status      String
  
  totalItems     Int @default(0)
  processedItems Int @default(0)
  failedItems    Int @default(0)
  
  results     Json?
  errorLog    String? @db.Text
  
  // Enhanced tracking
  stages              Json?     // Array of stage objects
  currentStage        String?
  isPaused            Boolean   @default(false)
  cancelRequested     Boolean   @default(false)
  cancellationReason  String?
  estimatedTimeRemaining Int?   // seconds
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  
  @@index([userId, status])
  @@index([createdAt])
}

// ============================================
// FULL SYNC - ENHANCED PRODUCT DATA
// ============================================

// Product variants (detailed)
model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  platform          Platform
  externalId        String
  
  sku               String?
  name              String?
  price             Decimal  @db.Decimal(10, 2)
  compareAtPrice    Decimal? @db.Decimal(10, 2)
  costPrice         Decimal? @db.Decimal(10, 2)
  
  inventoryLevel    Int      @default(0)
  inventoryTracking Boolean  @default(true)
  weight            Decimal? @db.Decimal(10, 2)
  weightUnit        String?
  
  optionValues      Json     // { "Color": "Red", "Size": "Large" }
  images            Json?
  dimensions        Json?
  
  platformData      Json?
  
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([productId, platform, externalId])
  @@index([productId])
  @@index([sku])
}

// Product modifiers
model ProductModifier {
  id                String   @id @default(cuid())
  productId         String
  platform          Platform
  externalId        String
  
  name              String
  displayName       String
  type              String   // dropdown, text, checkbox, file, etc.
  required          Boolean  @default(false)
  
  values            Json?    // For dropdown/radio options
  validation        Json?    // Min/max, regex, etc.
  
  platformData      Json?
  
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([productId, platform, externalId])
  @@index([productId])
}

// Product options
model ProductOption {
  id                String   @id @default(cuid())
  productId         String
  platform          Platform
  externalId        String
  
  name              String
  displayName       String
  type              String
  
  values            Json
  
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([productId, platform, externalId])
  @@index([productId])
}

// Custom fields
model ProductCustomField {
  id                String   @id @default(cuid())
  productId         String
  platform          Platform
  
  name              String
  value             String   @db.Text
  
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([productId, platform, name])
  @@index([productId])
}

// SEO data
model ProductSEO {
  id                String   @id @default(cuid())
  productId         String   @unique
  
  metaTitle         String?
  metaDescription   String?  @db.Text
  searchKeywords    String[]
  urlSlug           String?
  
  platformSEO       Json?
  
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

// Shipping data
model ProductShipping {
  id                String   @id @default(cuid())
  productId         String   @unique
  
  weight            Decimal? @db.Decimal(10, 2)
  weightUnit        String?
  
  width             Decimal? @db.Decimal(10, 2)
  height            Decimal? @db.Decimal(10, 2)
  depth             Decimal? @db.Decimal(10, 2)
  dimensionUnit     String?
  
  fixedCost         Decimal? @db.Decimal(10, 2)
  freeShipping      Boolean  @default(false)
  
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

// Inventory data
model ProductInventory {
  id                String   @id @default(cuid())
  productId         String
  variantId         String?  // Null for simple products
  locationId        String?  // For multi-location inventory
  
  quantity          Int      @default(0)
  tracking          String   // "product", "variant", "none"
  warningLevel      Int      @default(5)
  
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
  
  @@unique([productId, variantId, locationId])
  @@index([productId])
  @@index([quantity])
}

// Bulk pricing rules
model ProductBulkPricing {
  id                String   @id @default(cuid())
  productId         String
  
  minQuantity       Int
  maxQuantity       Int?
  price             Decimal  @db.Decimal(10, 2)
  type              String   // "fixed", "percent"
  
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([productId])
}

// Product reviews
model ProductReview {
  id                String   @id @default(cuid())
  productId         String
  platform          Platform
  externalId        String
  
  rating            Int
  reviewCount       Int      @default(0)
  
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([productId, platform])
  @@index([productId])
}

// Cross-listing
model CrossListing {
  id                String   @id @default(cuid())
  sourceProductId   String
  targetStoreId     String
  targetPlatform    Platform
  
  status            String   @default("draft")
  
  titleTemplate     String?
  descriptionTemplate String? @db.Text
  priceAdjustment   Json?
  categoryMapping   Json?
  tagMapping        Json?
  
  externalId        String?
  publishedAt       DateTime?
  publishError      String?  @db.Text
  
  sourceProduct     Product  @relation(fields: [sourceProductId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([sourceProductId, targetStoreId])
  @@index([status])
  @@index([sourceProductId])
}

// ============================================
// USAGE TRACKING
// ============================================

model UsageRecord {
  id           String    @id @default(cuid())
  userId       String
  action       String
  productCount Int       @default(1)
  platform     Platform?
  metadata     Json?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ============================================
// EMAIL LOGS
// ============================================

model EmailLog {
  id          String   @id @default(cuid())
  userId      String?
  to          String
  subject     String
  template    String
  status      String
  provider    String   @default("resend")
  providerId  String?
  error       String?  @db.Text
  metadata    Json?
  
  sentAt      DateTime @default(now())
  
  @@index([userId, sentAt])
  @@index([status])
  @@index([sentAt])
}

// ============================================
// ADMIN SETTINGS
// ============================================

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  type  String @default("string") // string, number, boolean, json
  category String @default("general") // general, stripe, email, integrations
  description String?
  isPublic Boolean @default(false) // Can be accessed by non-admin users
  
  updatedAt DateTime @updatedAt
  updatedBy String? // userId who last updated
  
  @@index([category])
  @@index([key])
}

// ============================================
// PAGE CONTENT MANAGEMENT
// ============================================

model Page {
  id          String  @id @default(cuid())
  slug        String  @unique // URL slug (e.g., "about", "contact")
  title       String
  content     String  @db.Text // HTML content from WYSIWYG editor
  metaTitle   String?
  metaDescription String?
  isPublished Boolean @default(true)
  isFooterLink Boolean @default(false) // Show in footer
  displayOrder Int    @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?  // userId who last updated
  
  @@index([slug])
  @@index([isPublished, isFooterLink])
}

// ============================================
// BULK OPERATIONS & BACKGROUND JOBS
// ============================================

model BulkOperation {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "price_update", "publish", "sync", "delete", "add_image", etc.
  status      String   // "queued", "processing", "completed", "failed", "cancelled"
  
  // Operation details
  totalItems     Int
  processedItems Int @default(0)
  successItems   Int @default(0)
  failedItems    Int @default(0)
  
  // What products were selected
  filters     Json?    // Filter criteria used to select products
  productIds  String[] // Explicit product IDs (if not using filters)
  
  // What changes to apply
  changes     Json?    // The changes to be applied
  
  // Results and errors
  results     Json?    // Detailed results per product
  errorLog    String?  @db.Text
  
  // Progress tracking
  progress    Int @default(0) // 0-100 percentage
  currentItem String?  // Current product being processed
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// SAVED FILTERS
// ============================================

model SavedFilter {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  
  // Filter configuration
  filters     Json     // Column filters, platform, status, price range, etc.
  sortBy      String?  // Field to sort by
  sortOrder   String?  // "asc" or "desc"
  groupBy     String?  // Field to group by
  
  // Display
  isDefault   Boolean @default(false)  // Use this filter by default
  isPinned    Boolean @default(false)  // Show in quick access
  icon        String?  // Optional icon name
  color       String?  // Optional color for UI
  
  // Usage tracking
  useCount    Int @default(0)
  lastUsedAt  DateTime?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([userId, isDefault])
  @@index([userId, isPinned])
}

// ============================================
// AI OPERATIONS
// ============================================

model AIOperation {
  id            String   @id @default(cuid())
  userId        String
  productId     String?  // Nullable for bulk operations
  operationType String   // "description", "title", "tags", "category", "image_enhance"
  
  // Input/Output
  input         Json     // Original data + parameters
  output        Json?    // Generated result
  prompt        String?  @db.Text // AI prompt used
  
  // Status
  status        String   // "queued", "processing", "completed", "failed"
  error         String?  @db.Text
  
  // Cost tracking
  model         String?  // AI model used (e.g., "gpt-4", "claude-3")
  tokensUsed    Int?     // Tokens consumed
  cost          Decimal? @db.Decimal(10, 4) // Cost in USD
  
  // Quality metrics
  confidence    Decimal? @db.Decimal(5, 2) // 0-100 confidence score
  userFeedback  String?  // "accepted", "rejected", "modified"
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  completedAt DateTime?
  
  @@index([userId, operationType])
  @@index([userId, status])
  @@index([createdAt])
  @@index([productId])
}

// ============================================
// PRODUCT STATUS ENUM (for future enhancement)
// ============================================

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  OUT_OF_STOCK
  ERROR
  SYNCING
  PENDING_APPROVAL
}

// ============================================
// POD PLATFORM - MASTER PRODUCTS & CHANNELS
// ============================================

// Master Product (Source of Truth)
model MasterProduct {
  id                String   @id @default(cuid())
  userId            String
  
  // Core fields
  title             String
  description       String?  @db.Text
  baseSKU           String
  basePrice         Decimal  @db.Decimal(10, 2)
  compareAtPrice    Decimal? @db.Decimal(10, 2)
  
  // Classification
  category          String?
  tags              String[]
  
  // Design & Template
  templateId        String?
  designIds         String[] // References to DesignLibrary
  
  // Media
  images            Json?    // Array of image URLs
  
  // Status
  status            ProductStatus @default(DRAFT)
  
  // Relations
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template          ProductTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  variants          MasterVariant[]
  channelListings   ChannelListing[]
  inventoryLevels   InventoryLevel[]
  legacyProducts    Product[]         // Backward compatibility
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([userId, status])
  @@index([baseSKU])
  @@index([userId, createdAt])
}

// Channel Listing (Platform-specific instance)
model ChannelListing {
  id                String   @id @default(cuid())
  userId            String   // Denormalized for queries
  masterProductId   String?  // Optional for now, will link to MasterProduct later
  storeConnectionId String
  platform          Platform
  externalId        String?  // ID on the platform (null until published)
  
  // Platform-specific overrides
  titleOverride      String?
  descriptionOverride String? @db.Text
  priceOverride      Decimal? @db.Decimal(10, 2)
  
  // Platform metadata
  platformCategories String[]
  platformTags       String[]
  platformData       Json?    // Platform-specific fields
  
  // Publishing
  publishStatus      String   @default("draft")  // draft, published, failed, syncing
  publishError       String?  @db.Text
  lastPushedAt       DateTime?
  lastPulledAt       DateTime?
  
  // Relations
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterProduct     MasterProduct?   @relation(fields: [masterProductId], references: [id], onDelete: Cascade)
  storeConnection   StoreConnection  @relation(fields: [storeConnectionId], references: [id], onDelete: Cascade)
  channelVariants   ChannelVariant[]
  legacyProducts    Product[]        // Backward compatibility
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([storeConnectionId, externalId])
  @@index([userId])
  @@index([masterProductId])
  @@index([publishStatus])
  @@index([storeConnectionId, publishStatus])
}

// Master Variant (Product variations)
model MasterVariant {
  id              String   @id @default(cuid())
  masterProductId String
  
  // Variant definition
  optionValues    Json     // { "Color": "Red", "Size": "Large" }
  
  // Variant specifics
  sku             String   @unique
  price           Decimal? @db.Decimal(10, 2)  // Override if different from base
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  
  // Images
  imageOverrides  String[] // Specific images for this variant
  
  // Relations
  masterProduct   MasterProduct    @relation(fields: [masterProductId], references: [id], onDelete: Cascade)
  inventoryLevel  InventoryLevel?
  channelVariants ChannelVariant[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([masterProductId])
  @@index([sku])
}

// Channel Variant (Platform-specific variant)
model ChannelVariant {
  id                String  @id @default(cuid())
  masterVariantId   String
  channelListingId  String
  externalId        String  // Platform's variant ID
  
  // Platform-specific overrides
  platformSKU       String?
  platformPrice     Decimal? @db.Decimal(10, 2)
  platformData      Json?
  
  // Relations
  masterVariant     MasterVariant  @relation(fields: [masterVariantId], references: [id], onDelete: Cascade)
  channelListing    ChannelListing @relation(fields: [channelListingId], references: [id], onDelete: Cascade)
  
  @@unique([channelListingId, externalId])
  @@index([masterVariantId])
  @@index([channelListingId])
}

// Inventory Management
model InventoryLevel {
  id                String   @id @default(cuid())
  userId            String
  masterProductId   String?  // For simple products
  masterVariantId   String?  // For variants
  
  // Master inventory
  totalQuantity     Int      @default(0)
  allocated         Int      @default(0)  // Reserved for orders
  available         Int      @default(0)  // Computed: total - allocated
  
  // Per-channel allocation
  channelAllocations Json?   // { "storeId1": 10, "storeId2": 5 }
  
  // Safety stock
  lowStockThreshold Int      @default(5)
  safetyStock       Int      @default(0)
  
  // Status
  trackInventory    Boolean  @default(true)
  allowBackorder    Boolean  @default(false)
  
  // Relations
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterProduct   MasterProduct? @relation(fields: [masterProductId], references: [id], onDelete: Cascade)
  masterVariant   MasterVariant? @relation(fields: [masterVariantId], references: [id], onDelete: Cascade)
  
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  
  @@unique([masterProductId])
  @@unique([masterVariantId])
  @@index([userId])
  @@index([available])
}

// Pricing Rules
model PricingRule {
  id              String   @id @default(cuid())
  userId          String
  name            String
  description     String?
  
  // Rule scope
  appliesTo       String   // "all", "specific_stores", "specific_products", "tagged"
  storeIds        String[]
  productIds      String[]
  tags            String[] // Apply to products with these tags
  
  // Rule logic
  ruleType        String   // "markup_percent", "markup_fixed", "set_price", "round_up", "round_down"
  value           Decimal  @db.Decimal(10, 2)
  
  // Platform-specific overrides
  platformRules   Json?    // { "ETSY": { type: "markup_percent", value: 10 } }
  
  // Status
  isActive        Boolean  @default(true)
  priority        Int      @default(0)  // Higher = applied first
  
  // Relations
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId, isActive])
  @@index([priority])
}

// Product Templates (for POD)
model ProductTemplate {
  id              String   @id @default(cuid())
  userId          String
  name            String
  description     String?
  category        String?  // "apparel", "accessories", etc.
  
  // Default settings
  basePrice       Decimal  @db.Decimal(10, 2)
  priceBySize     Json?    // { "S": 0, "M": 2, "L": 4, "XL": 6 }
  
  // Variant options
  variantOptions  Json     // { "Color": ["Red", "Blue"], "Size": ["S", "M", "L"] }
  
  // Design placeholders
  designSlots     Json?    // Where designs can be placed
  
  // Shipping
  weight          Decimal? @db.Decimal(10, 2)
  dimensions      Json?    // { length, width, height }
  
  // Platform defaults
  defaultTags     String[]
  defaultCategories Json?  // Platform-specific
  
  // Usage
  isActive        Boolean  @default(true)
  useCount        Int      @default(0)
  
  // Relations
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  products        MasterProduct[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId, isActive])
  @@index([category])
}

// Design Library (for POD)
model DesignLibrary {
  id              String   @id @default(cuid())
  userId          String
  name            String
  description     String?
  
  // File info
  fileUrl         String   // S3/Cloud Storage
  thumbnailUrl    String?
  fileType        String   // "png", "svg", "psd", "ai"
  fileSize        Int?     // bytes
  
  // Metadata
  tags            String[]
  collections     String[]
  
  // Usage
  usedInProducts  String[] // MasterProduct IDs
  
  // Relations
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([tags])
}

// Category Mappings
model CategoryMapping {
  id              String   @id @default(cuid())
  userId          String
  name            String   // User's category name
  
  // Platform-specific IDs
  etsyTaxonomyId  Int?
  bcCategoryId    Int?
  shopifyCollection String?
  tiktokCategoryId String?
  
  // Auto-mapping rules
  keywords        String[] // Keywords to auto-detect
  pattern         String?  // Regex pattern
  
  // Stats
  timesUsed       Int      @default(0)
  
  // Relations
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([name])
}

// Change Log (Audit Trail)
model ChangeLog {
  id              String   @id @default(cuid())
  userId          String
  entityType      String   // "product", "variant", "inventory", "price"
  entityId        String
  
  // Change details
  field           String
  oldValue        Json?
  newValue        Json?
  
  // Source tracking
  source          String   // "user", "sync", "webhook", "bulk_op"
  sourceId        String?  // Bulk operation ID, sync job ID, etc.
  platform        Platform?
  
  // Relations
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@index([userId, entityType, entityId])
  @@index([createdAt])
  @@index([source])
}

// Webhook Events
model WebhookEvent {
  id                String   @id @default(cuid())
  storeConnectionId String?
  platform          Platform
  eventType         String   // "product.updated", "inventory.updated", "order.created"
  
  // Payload
  payload           Json
  signature         String?  // For verification
  
  // Processing
  processed         Boolean  @default(false)
  processedAt       DateTime?
  processingError   String?  @db.Text
  retryCount        Int      @default(0)
  
  // Relations
  storeConnection StoreConnection? @relation(fields: [storeConnectionId], references: [id], onDelete: Cascade)
  
  receivedAt      DateTime @default(now())
  
  @@index([platform, processed])
  @@index([receivedAt])
  @@index([storeConnectionId, processed])
}